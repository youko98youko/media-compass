# メディアコンパス極 プロトタイプ用 環境変数サンプル
# このファイルを .env にコピーして値を設定してください（.env は絶対にコミットしないこと）

# OpenAI (ChatGPT) の API キー。設定すると実際のAIでヒアリング・記事生成を行います。
# 未設定の場合は「シミュレーションモード」で動作し、AI呼び出しの代わりに
# テンプレートベースの疑似応答（ユーザーの回答内容は反映されます）を返します。
OPENAI_API_KEY=

# 使用するモデル（省略時は gpt-4.1）
OPENAI_MODEL=gpt-4.1

# 挿入画像の自動生成（任意）。画像を1枚生成するごとに利用料がかかります。
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium   # low / medium / high
# IMAGE_MAX_PER_SESSION=15      # 1記事あたりの生成回数の上限

# Google Search Console 連携（OAuth）。未設定の間は、GSC連携画面はデモ表示のままです。
# 設定手順は README の「GSC連携の設定」を参照してください。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Googleの認証後に戻ってくるURL（Google Cloudの「承認済みのリダイレクトURI」と完全に一致させる）
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gsc/callback

# サーバーのポート（省略時は 3000）
PORT=3000
