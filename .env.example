# メディアコンパス極 プロトタイプ用 環境変数サンプル
# このファイルを .env にコピーして値を設定してください（.env は絶対にコミットしないこと）

# OpenAI (ChatGPT) の API キー。設定すると実際のAIでヒアリング・記事生成を行います。
# 未設定の場合は「シミュレーションモード」で動作し、AI呼び出しの代わりに
# テンプレートベースの疑似応答（ユーザーの回答内容は反映されます）を返します。
OPENAI_API_KEY=

# 使用するモデル（省略時は gpt-4.1）。gpt-5／gpt-6 系などの新しいモデルも指定できます（例：gpt-6-luna）。
# 使えるモデルは、お使いのAPIキーで異なります（OpenAIの GET /v1/models で確認できます）。
OPENAI_MODEL=gpt-4.1

# 挿入画像の自動生成（任意）。画像を1枚生成するごとに利用料がかかります。
# OPENAI_IMAGE_MODEL=gpt-image-1   # 例：gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=medium   # low / medium / high
# OPENAI_REASONING_EFFORT=low   # 新しい文章モデル用。考える深さ（none/low/medium/high/xhigh）。浅いほど速く・安い。省略＝モデルの既定
# IMAGE_MAX_PER_SESSION=15      # 1記事あたりの生成回数の上限

# Google Search Console 連携（OAuth）。未設定の間は、GSC連携画面はデモ表示のままです。
# 設定手順は README の「GSC連携の設定」を参照してください。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Googleの認証後に戻ってくるURL（Google Cloudの「承認済みのリダイレクトURI」と完全に一致させる）
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gsc/callback

# 公開環境（Render）でログイン必須にする場合（README「公開版でAIを使う」参照）
# PUBLIC_LOGIN=1
# ACCOUNT_USERS=tester1:password123   # ユーザー名:パスワード をカンマ区切り（パスワードは8文字以上）
# AI_DAILY_LIMIT=300                  # AIの1日あたりの利用回数の上限（文章）。公開環境の既定は300
# AI_IMAGE_DAILY_LIMIT=30             # 同（画像）。公開環境の既定は30

# サーバーのポート（省略時は 3000）
PORT=3000
